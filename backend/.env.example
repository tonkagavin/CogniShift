COGNISHIFT_FRONTEND_ORIGIN=http://localhost:5173

# Supabase (service key stays server-side)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Spotify OAuth (server side)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5173/dashboard

# EEG hardware streaming
EEG_SERIAL_PORT=COM3
# knight = NEUROPAWN_KNIGHT_BOARD (57), knight_imu = NEUROPAWN_KNIGHT_BOARD_IMU (66)
EEG_BOARD=knight
EEG_SERIAL_TIMEOUT_MS=0
EEG_SAMPLE_WINDOW_SECONDS=2
EEG_USE_SYNTHETIC=true
# Neuropawn template config (matches vendor sample commands chon_* and rldadd_*)
EEG_KNIGHT_CHANNEL_COUNT=8
EEG_KNIGHT_GAIN=12
EEG_KNIGHT_CONFIG_STEP_DELAY_SEC=0.15
EEG_GESTURE_MIN_GAP_SEC=1.8
# Gesture thresholds
# Jaw clench: spike in higher-frequency artifact band
EEG_JAW_SPIKE_THRESHOLD_UV=220
EEG_JAW_SPIKE_MIN_MS=40
EEG_JAW_SPIKE_MAX_MS=260
EEG_JAW_SPIKE_RMS_MULT=4.0
# Long blink: slower/lower-frequency deflection
EEG_BLINK_THRESHOLD_UV=90
EEG_BLINK_MIN_MS=300
EEG_BLINK_RMS_MULT=2.5
# Backward-compat vars (legacy names)
EEG_GESTURE_JAW_THRESHOLD=220
EEG_GESTURE_BLINK_THRESHOLD=90
# Optional: subset of BrainFlow EEG row indices (must each appear in GET /health → eeg.eegChannelRows)
# Example: EEG_BANDPOWER_ROWS=4,5,7,8
EEG_BANDPOWER_ROWS=
# Optional: BrainFlow Supported Boards → NeuroPawn Knight "other_info" JSON, e.g. {"gain":6}
EEG_OTHER_INFO=
# Optional: vendor-specific BrainFlow config_board string (only if documented for your firmware)
EEG_CONFIG_BOARD=
# Optional: log every outbound EEG websocket snapshot JSON in backend terminal
EEG_LOG_SNAPSHOTS=false

# Optional queue discovery expansion
LASTFM_API_KEY=your_lastfm_api_key

