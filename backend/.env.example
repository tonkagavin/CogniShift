COGNISHIFT_FRONTEND_ORIGIN=http://localhost:5173

# Supabase (service key stays server-side)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Spotify OAuth (server side)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5173/dashboard

# EEG hardware streaming
EEG_SERIAL_PORT=COM3
EEG_SAMPLE_WINDOW_SECONDS=2
EEG_USE_SYNTHETIC=true

# Optional queue discovery expansion
LASTFM_API_KEY=your_lastfm_api_key

